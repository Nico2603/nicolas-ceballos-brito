{
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.nicolasceballosbrito.com" }],
      "destination": "https://nicolasceballosbrito.com/:path*",
      "permanent": true
    },
    {
      "source": "/proyectos/chatbot-mental-health",
      "destination": "/salud-mental/chatbot-mental-health-bert",
      "permanent": true
    },
    {
      "source": "/proyectos/pdm-manager",
      "destination": "/mantenimiento-predictivo/pdm-manager",
      "permanent": true
    },
    {
      "source": "/proyectos/fastqa-homepage",
      "destination": "/webs/fastqa-homepage",
      "permanent": true
    },
    {
      "source": "/proyectos/magiacafetera-ui",
      "destination": "/webs/magiacafetera-ui",
      "permanent": true
    }
  ],
  "rewrites": [{ "source": "/(.*)", "destination": "/index.html" }],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/images/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=60, s-maxage=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/((?!assets|images).*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=60, s-maxage=86400, stale-while-revalidate=604800"
        }
      ]
    }
  ]
}
